{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lueurs",
  "version": "0.1.0",
  "identifier": "com.theophiledonato.lueurs",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lueurs",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 18, "y": 29 },
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "disableInputAccessoryView": true,
        "transparent": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' blob: data: asset: 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "Developer ID Application: JUBILATE POP LOUANGE (TBX8DPCBL9)",
      "infoPlist": "./Info.plist"
    },
    "iOS": {
      "developmentTeam": "TBX8DPCBL9"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
